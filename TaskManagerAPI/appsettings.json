{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Your_Connection_String_Here"
  },
  "Jwt": {
    "Key": "Your_Secret_Key_Here",
    "Issuer": "TaskManagerAPI",
    "Audience": "TaskManagerAPI",
    "ExpiryMinutes": 1440
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:YOUR_PORT" ]
  }
}